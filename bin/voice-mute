#!/usr/bin/env bash
# prefix+M: mute or unmute THIS session.
#
# Muted, the session says nothing on its own and offers no pane -- not at the
# end of a turn, not from voice-offer, not for notifications. Other sessions
# keep talking. prefix+v still speaks this session on demand.
#
#   voice-mute [pane] [on|off]     no state argument toggles
. "$HOME/.claude/hooks/speak.sh" 2>/dev/null || . "$(dirname "$0")/../hooks/speak.sh"

pane="${1:-${TMUX_PANE:-}}"; want="${2:-toggle}"
# From a key binding we get the pane; from the agent's own shell, its session.
if [ -n "$pane" ]; then
  export CC_TTS_PANE="$pane"; t=$(agent_session_transcript "$pane")
else
  t=$(agent_self_transcript)
fi || { tmux display-message "voice-mute: no agent session in this pane" 2>/dev/null; echo "voice-mute: no agent session" >&2; exit 1; }
sid=$(agent_session_id "$t")
d="${AGENTLABS_SESSIONS:-$HOME/.claude/scratch}/$sid"
mkdir -p "$d"

case "$want" in
  on|1)  new=1 ;;
  off|0) new=0 ;;
  *)     [ -f "$d/.mute" ] && new=0 || new=1 ;;
esac
if [ "$new" = 1 ]; then
  : > "$d/.mute"
  msg="voice MUTED for this session; other sessions unaffected"
else
  rm -f "$d/.mute"
  msg="voice UNMUTED for this session"
fi
tmux display-message "$msg" 2>/dev/null
echo "$msg"
tts_log "mute sid=${sid:0:8} -> $new"
