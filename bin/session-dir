#!/usr/bin/env bash
# Print (creating if needed) the workspace directory for a pane's agent session.
#
#   session-dir [PANE_ID]
#
# TMUX_PANE is EMPTY inside tmux run-shell bindings and display-popup, so the
# pane is passed in by whatever binding calls this.
#
# A supplied pane resolves its own session, or, for the shell beside an agent,
# that agent's (see agent_owner_pane). Without a pane, the legacy
# working-directory lookup remains available for use outside tmux.
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for c in "$HERE/../lib/agent.sh" "$HOME/.local/lib/agentlabs/agent.sh"; do
  [ -f "$c" ] && { . "$c"; break; }
done
command -v agent_pane_transcript >/dev/null || { echo "session-dir: lib/agent.sh not found" >&2; exit 1; }

pane="${1:-${TMUX_PANE:-}}"
sid=""
t=""

# A supplied pane is authoritative. Never choose a neighbor or global newest
# session when its mapping is missing.
if [ -n "$pane" ]; then
  t=$(agent_pane_transcript "$pane" 2>/dev/null) && sid=$(agent_session_id "$t")
  # Called from the shell beside the agent: use the agent it belongs to.
  if [ -z "$sid" ] && owner=$(agent_owner_pane "$pane"); then
    t=$(agent_pane_transcript "$owner" 2>/dev/null) && sid=$(agent_session_id "$t")
  fi
else
  t=$(agent_newest_transcript "$PWD" 2>/dev/null) && sid=$(agent_session_id "$t")
fi
[ -n "$sid" ] || { echo "session-dir: no agent session found for this pane" >&2; exit 1; }

root="${AGENTLABS_SESSIONS:-$(agent_session_root "$t")}" # scratch, never an agent-owned transcript store
agent_carry_over "$t"                                    # a daemon fork keeps its parent's folder
d="$root/$sid"
mkdir -p "$d/00-scratch" "$d/10-review" "$d/20-approved"
printf '%s\n' "$d"
